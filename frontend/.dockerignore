# 依赖（构建时重装）
node_modules/

# 构建产物（构建时重新生成）
.next/
out/
build/

# 本地 tsc 增量缓存（每次本地 build 都会变，会无谓打穿 COPY . . 缓存层）
tsconfig.tsbuildinfo

# 构建用不到的杂项（减小 build context）
package-lock.json
openapi.json

# 开发环境变量（排除，只保留 .env.production 用于构建）
.env
.env.local
.env.development

# 其他
.git
.gitignore
*.md
README.md

# IDE
.idea/
.vscode/

# 测试
coverage/

# 杂项
.DS_Store
*.pem

# AI Agent
.claude
prompt.md
CLAUDE.local.md

docs/
