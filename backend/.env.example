# ═══════════════════════════════════════════════════════════
# 公共 / 基座
# ═══════════════════════════════════════════════════════════

# —— 应用 ——
APP_NAME=dazah-backend
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-in-production

# —— 数据库 ——
# DATABASE_URL 供后端使用；以下 4 项供 docker-compose 起 Postgres 容器用
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dazah
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dazah
DB_PORT=5432

# —— Redis ——
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# —— 上传与对象存储 ——
# 本地文件上传根目录（工具箱产出、工单图片、职称评审附件等均落在其下）
UPLOAD_DIR=./uploads
# 上传大小上限（MB），与前端批量上传提示的 50MB 保持一致
MAX_UPLOAD_SIZE_MB=50
# MinIO / S3 对象存储（Docker 部署时启用，本地开发可关闭）
MINIO_ENABLED=false
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PREFIX=dazah
MINIO_SECURE=false

# —— 飞书全局应用（SSO 登录 / 组织架构同步 / 事件长连接）—— 必填，不设默认值
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_REDIRECT_URI=http://<your-server>/api/v1/identity/auth/callback
# 前端地址（SSO 回调跳转、通知中的链接）
FRONTEND_URL=http://<your-server>

# FEISHU_SYNC_ROOT_DEPT_ID: API POST /sync/departments 触发同步时的根部门
# FEISHU_SYNC_MEMBER_DEPT_ID: 每日 00:00 定时同步成员的目标部门
FEISHU_SYNC_ROOT_DEPT_ID=od-xxx
FEISHU_SYNC_MEMBER_DEPT_ID=od-xxx

# WebSocket 长连接开关（接收飞书消息/事件推送）
FEISHU_WS_ENABLED=true

# —— 认证 / 权限 ——
JWT_EXPIRE_SECONDS=86400
# 超级管理员工号（JSON 数组）
ADMIN_EMPLOYEE_NOS=["111003032"]
# MCP AI Agent API Keys（逗号分隔，service-to-service 认证）
MCP_AGENT_API_KEYS=

# —— 审计 ——
AUDIT_RETENTION_DAYS=7

# —— 日志（集中日志配置）——
# 全局日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 启用指定模块日志（逗号分隔短名，空 = 全部启用）
# 示例：LOG_ENABLED_MODULES=safety,equipment
LOG_ENABLED_MODULES=
# 禁用指定模块日志（逗号分隔短名，空 = 不禁用）
# 仅在 LOG_ENABLED_MODULES 为空时生效
# 示例：LOG_DISABLED_MODULES=energy,hr
LOG_DISABLED_MODULES=
# 三方库统一日志级别（可被细粒度 LOG_<LIB>_LEVEL 覆盖）
# 优先级：LOG_SQLALCHEMY_LEVEL > LOG_THIRD_PARTY_LEVEL > 内置默认值
LOG_THIRD_PARTY_LEVEL=WARNING
# 三方库 handler 级过滤阈值（防止库内部 setLevel 绕过）
# 仅影响控制台输出，低于此级别的三方库日志不会进入 stdout
LOG_THIRD_PARTY_HANDLER_LEVEL=WARNING
# root logger 兜底级别（仅影响未被上述 logger 覆盖的日志）
LOG_ROOT_LEVEL=WARNING
# 生产环境日志文件目录（仅 APP_ENV=production 时写入）
LOG_DIR=logs

# ═══════════════════════════════════════════════════════════
# 业务模块
# ═══════════════════════════════════════════════════════════

# —— 安全模块 safety ——
# 交互机器人（WebSocket 事件订阅，独立飞书应用凭证）
SAFETY_FEISHU_WS_ENABLED=true
SAFETY_FEISHU_APP_ID=***
SAFETY_FEISHU_APP_SECRET=***
# 隐患登记多维表格同步
SAFETY_FEISHU_BITABLE_APP_TOKEN=UKlobrKj3aQ24XsBRkTcqdL0nkc
SAFETY_FEISHU_BITABLE_HAZARD_TABLE_ID=tblB7D5BjNSOruaD
# 知识库法规标准清单多维表格同步
SAFETY_FEISHU_BITABLE_KNOWLEDGE_APP_TOKEN=IkYTw6PJPiKZTCkfuNQc7IqEnzd
SAFETY_FEISHU_BITABLE_KNOWLEDGE_TABLE_ID=tbl85HKWCTfyf6rw
# AI 模型配置（文本 / 视觉）
SAFETY_AI_TEXT_API_KEY=
SAFETY_AI_TEXT_BASE_URL=
SAFETY_AI_TEXT_MODEL=
SAFETY_AI_VISION_API_KEY=
SAFETY_AI_VISION_BASE_URL=
SAFETY_AI_VISION_MODEL=

# —— 设备模块 equipment ——
# 设备部飞书群 / 部门（巡检提醒、工单通知推送目标）
FEISHU_EQUIPMENT_DEPT_ID=
FEISHU_EQUIPMENT_CHAT_ID=oc_ba1a54a70a0d611315f29581621c50b5
# AI 模型配置
EQUIPMENT_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EQUIPMENT_AI_MODEL=qwen3.7-plus
EQUIPMENT_AI_API_KEY=sk-xxx
# 维护计划自动生成工单
MAINTENANCE_PLAN_AUTO_ENABLED=true

# —— HR 模块 ——
# AI 出题 / 人事问答 / 面试评价 / 胜任度分析（DeepSeek，统一一个 key）
# 真实 key 只放在服务器的 .env.production 中，不要提交到 git
HR_AI_API_KEY=
# 旧命名兼容：HR_AI_API_KEY 为空时回落该值（历史 .env 用此命名）
HR_DEEPSEEK_API_KEY=
HR_AI_MODEL=deepseek-chat
# 职称评审：独立飞书应用凭证（审批同步用：approval:approval:readonly / approval:definition，缺省回落全局应用）
# 多维表格读写与通知卡片始终使用全局应用
HR_TITLE_REVIEW_FEISHU_APP_ID=
HR_TITLE_REVIEW_FEISHU_APP_SECRET=
# 是否用独立应用建立事件长连接（false=仅 5 分钟对账模式）
HR_TITLE_REVIEW_FEISHU_WS_ENABLED=false
# 职称评审 5 分钟定时对账开关（关闭后仅保留手动「同步」按钮）
HR_TITLE_REVIEW_SYNC_ENABLED=true
# 飞书日历集成（面试日程自动同步；primary=主日历，或指定团队日历 ID）
HR_FEISHU_CALENDAR_ID=primary
# 绩效飞书通知开关（自评/领导评分提交后通知负责人/领导）
HR_PERFORMANCE_NOTIFY=false

# —— Meter 模块 ——
# 检定到期飞书自动提醒
METER_CALIBRATION_AUTO_NOTIFY_ENABLED=false
# AI 模型配置（多模态视觉模型，识别检定报告字段）
METER_AI_BASE_URL=https://api.deepseek.com
METER_AI_MODEL=deepseek-v4-flash-vision-exp
METER_AI_API_KEY=  # DeepSeek 官方 key

# —— QA 模块 ——
# QA 原生文档实体分析：逐 chunk 调模型抽取实体，需 OpenAI 兼容协议
# 总开关；false 或 API_KEY 为空时不调模型，实体仅保留规则匹配结果
QA_AI_ENABLED=false
QA_AI_BASE_URL=https://api.openai.com/v1
QA_AI_API_KEY=
QA_AI_MODEL=gpt-4o-mini
# 单次请求超时（秒），超时计入重试；服务器到模型 API 的延迟高于本地，部署时按需调大
QA_AI_TIMEOUT_SECONDS=120
# 模型【输出】上限，不是输入上限（单块文本上限见分块常量，与此无关）
# 调小会导致实体 JSON 被截断 → 该 chunk 分析失败、整体标记 partial
QA_AI_MAX_TOKENS=4096
# 重试次数，总尝试次数 = 本值 + 1；仅 429/5xx/超时/响应解析失败重试，其他 4xx 直接失败
QA_AI_MAX_RETRIES=2
# 以下两项是溯源与缓存失效开关：写入每次分析记录（前端可见），并参与输入指纹，
# 改动即让历史分析结果失效、触发重新分析。
# 注意：提示词正文硬编码在 ai_analysis.py 的 _model_entities 中、不参与指纹计算，
# 改完提示词必须同步 bump 本项，否则旧结果会被直接复用而无人察觉。
QA_AI_PROMPT_VERSION=qa-entity-v1
QA_AI_SCHEMA_VERSION=qa-entity-schema-v1

# —— Energy 模块 ——
# 能耗自动采集
ENERGY_AUTO_COLLECT_ENABLED=false
# 车间能耗预警
ENERGY_WORKSHOP_ALERT_ENABLED=false
# 日耗推送 / 氮气月度推送
ENERGY_DAILY_PUSH_ENABLED=false
ENERGY_NITROGEN_PUSH_ENABLED=false
