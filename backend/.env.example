# ═══════════════════════════════════════════════════════════
# 公共 / 基座
# ═══════════════════════════════════════════════════════════

# —— 应用 ——
APP_NAME=dazah-backend
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-in-production

# —— 数据库 ——
# DATABASE_URL 供后端使用；以下 4 项供 docker-compose 起 Postgres 容器用
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dazah
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dazah
DB_PORT=5432

# —— Redis ——
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# —— 上传与对象存储 ——
# 本地文件上传根目录（工具箱产出、工单图片、职称评审附件等均落在其下）
UPLOAD_DIR=./uploads
# 上传大小上限（MB），与前端批量上传提示的 50MB 保持一致
MAX_UPLOAD_SIZE_MB=50
# MinIO / S3 对象存储（Docker 部署时启用，本地开发可关闭）
MINIO_ENABLED=false
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PREFIX=dazah
MINIO_SECURE=false

# —— 飞书全局应用（SSO 登录 / 组织架构同步 / 事件长连接）—— 必填，不设默认值
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_REDIRECT_URI=http://<your-server>/api/v1/identity/auth/callback
# 前端地址（SSO 回调跳转、通知中的链接）
FRONTEND_URL=http://<your-server>

# FEISHU_SYNC_ROOT_DEPT_ID: API POST /sync/departments 触发同步时的根部门
# FEISHU_SYNC_MEMBER_DEPT_ID: 每日 00:00 定时同步成员的目标部门
FEISHU_SYNC_ROOT_DEPT_ID=od-xxx
FEISHU_SYNC_MEMBER_DEPT_ID=od-xxx

# WebSocket 长连接开关（接收飞书消息/事件推送）
FEISHU_WS_ENABLED=true

# —— 认证 / 权限 ——
JWT_EXPIRE_SECONDS=86400
# 超级管理员工号（JSON 数组）
ADMIN_EMPLOYEE_NOS=["111003032"]
# MCP AI Agent API Keys（逗号分隔，service-to-service 认证）
MCP_AGENT_API_KEYS=

# —— 审计 ——
AUDIT_RETENTION_DAYS=7

# —— 日志（集中日志配置）——
# 全局日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 启用指定模块日志（逗号分隔短名，空 = 全部启用）
# 示例：LOG_ENABLED_MODULES=safety,equipment
LOG_ENABLED_MODULES=
# 禁用指定模块日志（逗号分隔短名，空 = 不禁用）
# 仅在 LOG_ENABLED_MODULES 为空时生效
# 示例：LOG_DISABLED_MODULES=energy,hr
LOG_DISABLED_MODULES=
# 三方库统一日志级别（可被细粒度 LOG_<LIB>_LEVEL 覆盖）
# 优先级：LOG_SQLALCHEMY_LEVEL > LOG_THIRD_PARTY_LEVEL > 内置默认值
LOG_THIRD_PARTY_LEVEL=WARNING
# 三方库 handler 级过滤阈值（防止库内部 setLevel 绕过）
# 仅影响控制台输出，低于此级别的三方库日志不会进入 stdout
LOG_THIRD_PARTY_HANDLER_LEVEL=WARNING
# root logger 兜底级别（仅影响未被上述 logger 覆盖的日志）
LOG_ROOT_LEVEL=WARNING
# 生产环境日志文件目录（仅 APP_ENV=production 时写入）
LOG_DIR=logs

# ═══════════════════════════════════════════════════════════
# 业务模块
# ═══════════════════════════════════════════════════════════

# —— 安全模块 safety ——
# 交互机器人（WebSocket 事件订阅，独立飞书应用凭证）
SAFETY_FEISHU_WS_ENABLED=true
SAFETY_FEISHU_APP_ID=***
SAFETY_FEISHU_APP_SECRET=***
# 隐患登记多维表格同步
SAFETY_FEISHU_BITABLE_APP_TOKEN=UKlobrKj3aQ24XsBRkTcqdL0nkc
SAFETY_FEISHU_BITABLE_HAZARD_TABLE_ID=tblB7D5BjNSOruaD
# 知识库法规标准清单多维表格同步
SAFETY_FEISHU_BITABLE_KNOWLEDGE_APP_TOKEN=IkYTw6PJPiKZTCkfuNQc7IqEnzd
SAFETY_FEISHU_BITABLE_KNOWLEDGE_TABLE_ID=tbl85HKWCTfyf6rw
# AI 模型配置（文本 / 视觉）
SAFETY_AI_TEXT_API_KEY=
SAFETY_AI_TEXT_BASE_URL=
SAFETY_AI_TEXT_MODEL=
SAFETY_AI_VISION_API_KEY=
SAFETY_AI_VISION_BASE_URL=
SAFETY_AI_VISION_MODEL=

# —— 设备模块 equipment ——
# 设备部飞书群 / 部门（巡检提醒、工单通知推送目标）
FEISHU_EQUIPMENT_DEPT_ID=
FEISHU_EQUIPMENT_CHAT_ID=oc_ba1a54a70a0d611315f29581621c50b5
# AI 模型配置
EQUIPMENT_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EQUIPMENT_AI_MODEL=qwen3.7-plus
EQUIPMENT_AI_API_KEY=sk-xxx
# 维护计划自动生成工单
MAINTENANCE_PLAN_AUTO_ENABLED=true

# —— HR 模块 ——
# AI 出题 / 人事问答 / 面试评价 / 胜任度分析（DeepSeek，统一一个 key）
# 真实 key 只放在服务器的 .env.production 中，不要提交到 git
HR_AI_API_KEY=
# 旧命名兼容：HR_AI_API_KEY 为空时回落该值（历史 .env 用此命名）
HR_DEEPSEEK_API_KEY=
HR_AI_MODEL=deepseek-flash
# 职称评审：独立飞书应用凭证（审批同步用：approval:approval:readonly / approval:definition，缺省回落全局应用）
# 多维表格读写与通知卡片始终使用全局应用
HR_TITLE_REVIEW_FEISHU_APP_ID=
HR_TITLE_REVIEW_FEISHU_APP_SECRET=
# 是否用独立应用建立事件长连接（false=仅 5 分钟对账模式）
HR_TITLE_REVIEW_FEISHU_WS_ENABLED=false
# 职称评审 5 分钟定时对账开关（关闭后仅保留手动「同步」按钮）
HR_TITLE_REVIEW_SYNC_ENABLED=true
# 飞书日历集成（面试日程自动同步；primary=主日历，或指定团队日历 ID）
HR_FEISHU_CALENDAR_ID=primary
# 绩效飞书通知开关（自评/领导评分提交后通知负责人/领导）
HR_PERFORMANCE_NOTIFY=false

# —— Meter 模块 ——
# 检定到期飞书自动提醒
METER_CALIBRATION_AUTO_NOTIFY_ENABLED=false
# AI 模型配置（多模态视觉模型，识别检定报告字段）
METER_AI_BASE_URL=https://api.deepseek.com
METER_AI_MODEL=deepseek-flash
METER_AI_API_KEY=  # DeepSeek 官方 key

# —— Energy 模块 ——
# 能耗自动采集
ENERGY_AUTO_COLLECT_ENABLED=false
# 车间能耗预警
ENERGY_WORKSHOP_ALERT_ENABLED=false
# 日耗推送 / 氮气月度推送
ENERGY_DAILY_PUSH_ENABLED=false
ENERGY_NITROGEN_PUSH_ENABLED=false

# ---- 仓储模块专属飞书应用（仓库管理机器人）与 Agent 模型 ----
# 提示：WAREHOUSE_AGENT_* 各键现为「DB 缺行时的字段级兜底层」——管理页
# （/warehouse/system）落库配置优先于本文件，改值无需重启。
WAREHOUSE_FEISHU_APP_ID=
WAREHOUSE_FEISHU_APP_SECRET=
# 仓储机器人专属飞书事件 WS 长连接开关（true 时 main.py 启动 warehouse WS 客户端）
WAREHOUSE_FEISHU_WS_ENABLED=false
# 冒烟测试用群 chat_id（配置后冒烟测试真发一张卡片到该群，未配置则跳过）
WAREHOUSE_TEST_CHAT_ID=
# 仓库机器人 open_id（部署身份：gateway 去重排除自身消息；未配置回退代码内默认值）
WAREHOUSE_FEISHU_BOT_OPEN_ID=
WAREHOUSE_FEISHU_BITABLE_MATERIAL_APP_TOKEN=
WAREHOUSE_FEISHU_BITABLE_GMP_APP_TOKEN=
WAREHOUSE_FEISHU_BITABLE_PROD_APP_TOKEN=
WAREHOUSE_FEISHU_BITABLE_SALES_APP_TOKEN=
# 遗留键（工作版预留）：连接坐标已由管理页 bitable_connections DB 行承接，此键不再读取
WAREHOUSE_FEISHU_BITABLE_MATERIAL_PROD_APP_TOKEN=
WAREHOUSE_AGENT_BASE_URL=
WAREHOUSE_AGENT_API_KEY=
WAREHOUSE_AGENT_MODEL=
WAREHOUSE_AGENT_TIMEOUT=120
# Agent 备用模型（主模型 401/429/5xx/超时自动降级；三项齐备才启用降级）
WAREHOUSE_AGENT_BACKUP_API_KEY=
WAREHOUSE_AGENT_BACKUP_BASE_URL=
WAREHOUSE_AGENT_BACKUP_MODEL=
# 系统提示词追加段（DB 配置 system_prompt_override 缺行时兜底）
WAREHOUSE_AGENT_SYSTEM_PROMPT=
# 系统告警目标群（AI 调用失败等告警；DB 配置 system_alert.target 缺行时兜底）
WAREHOUSE_ALERT_CHAT_ID=
# Runner tool-calling 循环上限 / 会话历史注入轮数（DB 配置缺行时兜底）
WAREHOUSE_AGENT_MAX_TURNS=10
WAREHOUSE_AGENT_SESSION_ROUNDS=12

# ---- 安全模块：AI 检索增强（向量/备用模型） ----
SAFETY_AI_TEXT_BACKUP_API_KEY=
SAFETY_AI_TEXT_BACKUP_BASE_URL=
SAFETY_AI_TEXT_BACKUP_MODEL=
SAFETY_EMBEDDING_API_KEY=
SAFETY_EMBEDDING_BASE_URL=
SAFETY_EMBEDDING_MODEL=

# ---- 安全模块：平台对接（EHS 平台账号，供 hazard_direct / supervision 同步） ----
SAFETY_PLATFORM_BASE_URL=
SAFETY_PLATFORM_TENANT_ID=
SAFETY_PLATFORM_ORG_CODE=
SAFETY_PLATFORM_USERNAME=
SAFETY_PLATFORM_PASSWORD_MD=
# 旧命名兼容：代码实际读取 SAFETY_PLATFORM_PASSWORD_MD5
SAFETY_PLATFORM_PASSWORD_MD5=
SAFETY_PLATFORM_AUTH_BASIC=

# ---- 安全模块：隐患轮询/事件同步/催报开关（默认关闭，按需开启） ----
SAFETY_HAZARD_POLL_ENABLED=false
SAFETY_HAZARD_POLL_INTERVAL_SECONDS=300
SAFETY_HAZARD_POLL_BATCH_LIMIT=200
SAFETY_HAZARD_POLL_CONCURRENCY=3
SAFETY_HAZARD_POLL_LOCK_TTL=600
SAFETY_HAZARD_POLL_STAGGER_SECONDS=150
SAFETY_HAZARD_ALERT_MIN_FAILURES=10
SAFETY_HAZARD_ALERT_AFTER_ROUNDS=3
SAFETY_HAZARD_EVENT_SYNC_ENABLED=false
SAFETY_HAZARD_CATCHUP_ENABLED=false
SAFETY_HAZARD_NOTIFICATIONS_ENABLED=false
SAFETY_HAZARD_AI_POLL_ENABLED=false
SAFETY_HAZARD_REVIEW_POLL_ENABLED=false
SAFETY_HAZARD_DIRECT_POLL_ENABLED=false
SAFETY_HAZARD_SUPERVISION_POLL_ENABLED=false
SAFETY_HAZARD_SUPERVISION_STAGGER_SECONDS=75

# ---- 安全模块：特殊作业日报「直读多维表格」开关（默认关闭 = 与改造前行为一致） ----
# 语义：直读总开关关闭时旧链路（事件镜像 / 08:00 全量对账 / 17:00 增量同步）恒生效；
#       打开直读总开关后，旧链路默认停止，可用下面两个单项开关显式恢复（回滚/双跑）。
SAFETY_SPECIAL_OP_DIRECT_ENABLED=false
SAFETY_SPECIAL_OP_EVENT_SYNC_ENABLED=false
SAFETY_SPECIAL_OP_SYNC_JOB_ENABLED=false
SAFETY_SPECIAL_OP_WRITEBACK_RISK_ENABLED=false
# 速递卡：日报推送改速递式布局（默认开启；显式置 false 回退旧长卡，
# 构建失败/卡片超限时代码内自动回退，不影响送达）
# SAFETY_SPECIAL_OP_DIGEST_CARD_ENABLED=true

# ---- 安全模块：「安全速递」每日总卡（各报告推送时滚动追加格子） ----
# 默认开启：各报告推送时把自己的概览+明细投递为当日总卡的一个格子，
# 总卡滚动更新发到安全AI创新交流群；开启后该群各日报不再单独发卡。
# 置 false 则各报告恢复独立群卡、总卡停用。
# SAFETY_DAILY_DIGEST_ENABLED=true
# 总卡目标群（默认安全AI创新交流群）
# SAFETY_DAILY_DIGEST_CHAT_ID=oc_f05532603bd7682fc520929c01aca88d

# ---- 安全模块：通知群（留空则不发） ----
SAFETY_CENTRAL_ALARM_ANALYSIS_CHAT_ID=
SAFETY_FIRE_ALARM_ANALYSIS_CHAT_ID=
SAFETY_CHEMICAL_INVENTORY_ALERT_CHAT_ID=
SAFETY_CHEMICAL_INVENTORY_DAILY_CHAT_ID=
SAFETY_CHEMICAL_INVENTORY_WEEKLY_CHAT_ID=
SAFETY_CHEMICAL_INVENTORY_DAILY_REALTIME_ENABLED=false
SAFETY_FIRE_ALARM_DAILY_DM_ENABLED=false
# ---- 安全模块：消防报警直读改造（全部默认关闭） ----
# 生成路径是否走 Bitable 直读；关闭时保持平台库镜像路径。
SAFETY_FIRE_ALARM_DIRECT_ENABLED=false
# 旧路径：Bitable 事件 -> 平台库镜像；直读打开后默认停止。
SAFETY_FIRE_ALARM_EVENT_SYNC_ENABLED=false
# 旧路径：生成前全量同步兜底；直读打开后默认停止。
SAFETY_FIRE_ALARM_SYNC_JOB_ENABLED=false
# AI 分析结果是否回写 Bitable 的 4 个 AI 列；默认关闭。
SAFETY_FIRE_ALARM_WRITEBACK_AI_ENABLED=false

# ---- 安全模块：中控报警直读改造（全部默认关闭；纯只读域无回写开关） ----
# 生成/查询路径是否走 Bitable 直读；关闭时保持平台库镜像路径。
SAFETY_CENTRAL_ALARM_DIRECT_ENABLED=false
# 旧路径：Bitable 事件 -> 平台库镜像；直读打开后默认停止。
SAFETY_CENTRAL_ALARM_EVENT_SYNC_ENABLED=false
# 旧路径：生成前全量同步兜底；直读打开后默认停止。
SAFETY_CENTRAL_ALARM_SYNC_JOB_ENABLED=false

# ---- 安全模块：持证到期直读改造（全部默认关闭；纯只读域无回写开关） ----
# 生成/查询路径是否走 Bitable 直读；关闭时保持平台库镜像路径。
SAFETY_CERT_DIRECT_ENABLED=false
# 旧路径：Bitable 事件 -> 平台库镜像；直读打开后默认停止。
SAFETY_CERT_EVENT_SYNC_ENABLED=false

# ---- 安全模块：法规爬虫 ----
SAFETY_REGULATION_CRAWLER_ENABLED=false
SAFETY_REGULATION_CRAWLER_INTERVAL_HOURS=0
SAFETY_REGULATION_CRAWLER_NOTIFY_CHAT_ID=
SAFETY_REGULATION_CRAWLER_NOTIFY_USERS=
SAFETY_REGULATION_CRAWLER_WEBHOOK_SECRET=

# ---- 安全模块：可观测性 ----
SAFETY_PHOENIX_ENDPOINT=

# ---- 安全模块：Bitable 域 app_token 覆盖（不设则用代码内默认值=本厂测试版 Base） ----
# 键名规则：SAFETY_BITABLE_APP_TOKEN_{域名大写}，域名见 bitable_config/registry.py
# SAFETY_BITABLE_APP_TOKEN_HAZARD=
# SAFETY_BITABLE_APP_TOKEN_KNOWLEDGE=
# SAFETY_BITABLE_APP_TOKEN_SPECIAL_OP=
# SAFETY_BITABLE_APP_TOKEN_KEY_RISK_OP=
# SAFETY_BITABLE_APP_TOKEN_CENTRAL_ALARM=
# SAFETY_BITABLE_APP_TOKEN_DRILL=
# SAFETY_BITABLE_APP_TOKEN_OH=
# SAFETY_BITABLE_APP_TOKEN_CONTRACTOR_ADMISSION=
# SAFETY_BITABLE_APP_TOKEN_EHS_CHANGE=
# SAFETY_BITABLE_APP_TOKEN_CHEMICAL_INVENTORY=
