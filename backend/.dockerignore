# Python venv — 镜像中由 uv sync 创建，不要从宿主机覆盖
.venv

# Python 缓存
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache

# IDE / 系统元数据
.idea
.vscode
*.swp
*.swo
.DS_Store

# Git
.git
.gitignore

# 环境文件（通过 docker-compose env_file 注入）
.env
.env.*
!.env.example

# 日志
logs/

# 运行时数据（通过 volume 挂载，不进镜像；变化会打穿 COPY 缓存）
uploads/
temp/

# 文档
*.md
!CLAUDE.md
.claude
docs

# 测试文件
tests