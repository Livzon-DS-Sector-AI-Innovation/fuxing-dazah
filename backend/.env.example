# ═══════════════════════════════════════════════════════════
# 公共 / 基座
# ═══════════════════════════════════════════════════════════

# —— 应用 ——
APP_NAME=dazah-backend
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-in-production

# —— 数据库 ——
# DATABASE_URL 供后端使用；以下 4 项供 docker-compose 起 Postgres 容器用
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dazah
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dazah
DB_PORT=5432

# —— Redis ——
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# —— 上传与对象存储 ——
# 本地文件上传根目录（工具箱产出、工单图片、职称评审附件等均落在其下）
UPLOAD_DIR=./uploads
# 上传大小上限（MB），与前端批量上传提示的 50MB 保持一致
MAX_UPLOAD_SIZE_MB=50
# MinIO / S3 对象存储（Docker 部署时启用，本地开发可关闭）
MINIO_ENABLED=false
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PREFIX=dazah
MINIO_SECURE=false

# —— 飞书全局应用（SSO 登录 / 组织架构同步 / 事件长连接）—— 必填，不设默认值
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_REDIRECT_URI=http://<your-server>/api/v1/identity/auth/callback
# 前端地址（SSO 回调跳转、通知中的链接）
FRONTEND_URL=http://<your-server>

# FEISHU_SYNC_ROOT_DEPT_ID: API POST /sync/departments 触发同步时的根部门
# FEISHU_SYNC_MEMBER_DEPT_ID: 每日 00:00 定时同步成员的目标部门
FEISHU_SYNC_ROOT_DEPT_ID=od-xxx
FEISHU_SYNC_MEMBER_DEPT_ID=od-xxx

# WebSocket 长连接开关（接收飞书消息/事件推送）
FEISHU_WS_ENABLED=true

# —— 认证 / 权限 ——
JWT_EXPIRE_SECONDS=86400
# 超级管理员工号（JSON 数组）
ADMIN_EMPLOYEE_NOS=["111003032"]
# MCP AI Agent API Keys（逗号分隔，service-to-service 认证）
MCP_AGENT_API_KEYS=

# —— 审计 ——
AUDIT_RETENTION_DAYS=7

# —— 日志（集中日志配置）——
# 全局日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 启用指定模块日志（逗号分隔短名，空 = 全部启用）
# 示例：LOG_ENABLED_MODULES=equipment,energy
LOG_ENABLED_MODULES=
# 禁用指定模块日志（逗号分隔短名，空 = 不禁用）
# 仅在 LOG_ENABLED_MODULES 为空时生效
# 示例：LOG_DISABLED_MODULES=energy,hr
LOG_DISABLED_MODULES=
# 三方库统一日志级别（可被细粒度 LOG_<LIB>_LEVEL 覆盖）
# 优先级：LOG_SQLALCHEMY_LEVEL > LOG_THIRD_PARTY_LEVEL > 内置默认值
LOG_THIRD_PARTY_LEVEL=WARNING
# 三方库 handler 级过滤阈值（防止库内部 setLevel 绕过）
# 仅影响控制台输出，低于此级别的三方库日志不会进入 stdout
LOG_THIRD_PARTY_HANDLER_LEVEL=WARNING
# root logger 兜底级别（仅影响未被上述 logger 覆盖的日志）
LOG_ROOT_LEVEL=WARNING
# 生产环境日志文件目录（仅 APP_ENV=production 时写入）
LOG_DIR=logs

# ═══════════════════════════════════════════════════════════
# 业务模块
# ═══════════════════════════════════════════════════════════

# —— 设备模块 equipment ——
# 设备部飞书群 / 部门（巡检提醒、工单通知推送目标）
FEISHU_EQUIPMENT_DEPT_ID=
FEISHU_EQUIPMENT_CHAT_ID=oc_ba1a54a70a0d611315f29581621c50b5
# AI 模型配置
EQUIPMENT_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EQUIPMENT_AI_MODEL=qwen3.7-plus
EQUIPMENT_AI_API_KEY=sk-xxx
# 维护计划自动生成工单
MAINTENANCE_PLAN_AUTO_ENABLED=true

# —— HR 模块 ——
# AI 出题 / 人事问答 / 面试评价 / 胜任度分析（DeepSeek，统一一个 key）
# 真实 key 只放在服务器的 .env.production 中，不要提交到 git
HR_AI_API_KEY=
HR_AI_MODEL=deepseek-flash
# HR 专属飞书应用凭证 — 员工档案 bitable 同步 + 职称评审审批同步共用同一应用时只配这一对
# 下方两个专用变量留空时自动回填本值；留空且本值也为空时回落全局 FEISHU_APP_ID
HR_FEISHU_APP_ID=
HR_FEISHU_APP_SECRET=
# 职称评审：独立飞书应用凭证（审批同步用：approval:approval:readonly / approval:definition）
# 仅当与上面的 HR 专属应用不是同一个时才需要配置
# 多维表格读写与通知卡片始终使用全局应用
HR_TITLE_REVIEW_FEISHU_APP_ID=
HR_TITLE_REVIEW_FEISHU_APP_SECRET=
# 是否用独立应用建立事件长连接（false=仅 5 分钟对账模式）
HR_TITLE_REVIEW_FEISHU_WS_ENABLED=false
# 职称评审 5 分钟定时对账开关（关闭后仅保留手动「同步」按钮）
HR_TITLE_REVIEW_SYNC_ENABLED=true

# 员工档案多维表格同步 — 独立应用凭证（bitable 读写）
# 仅当与职称评审不是同一个应用时才需要配置
# 多环境共用一个应用时，Base 只需共享给该应用一次；事件订阅仍走各环境全局应用
HR_EMPLOYEE_SYNC_FEISHU_APP_ID=
HR_EMPLOYEE_SYNC_FEISHU_APP_SECRET=
# 绩效飞书通知开关（自评/领导评分提交后通知负责人/领导）
HR_PERFORMANCE_NOTIFY=false

# —— Meter 模块 ——
# 检定到期飞书自动提醒
METER_CALIBRATION_AUTO_NOTIFY_ENABLED=false
# AI 模型配置（多模态视觉模型，识别检定报告字段）
METER_AI_BASE_URL=https://api.deepseek.com
METER_AI_MODEL=deepseek-flash
METER_AI_API_KEY=  # DeepSeek 官方 key

# —— QA 模块 ——
# QA 模型配置（实体分析 + COA docx 导入共用）：
# - 实体分析：逐 chunk 调模型抽取实体，需 OpenAI 兼容协议；未启用时实体仅保留规则匹配结果
# - COA docx 导入（标准/报告）：启用 OCR（/v1/tools/ocr）+ 提取，未启用时导入接口直接 503
#   BASE_URL 兼容带/不带 /v1 两种写法（COA OCR 路径会自动补齐，不会出现 /v1/v1）
QA_AI_ENABLED=false
QA_AI_BASE_URL=https://api.openai.com/v1
QA_AI_API_KEY=
QA_AI_MODEL=gpt-4o-mini
# 单次请求超时（秒），超时计入重试；服务器到模型 API 的延迟高于本地，部署时按需调大
QA_AI_TIMEOUT_SECONDS=120
# 模型【输出】上限，不是输入上限（单块文本上限见分块常量，与此无关）
# 调小会导致实体 JSON 被截断 → 该 chunk 分析失败、整体标记 partial
QA_AI_MAX_TOKENS=4096
# 重试次数，总尝试次数 = 本值 + 1；仅 429/5xx/超时/响应解析失败重试，其他 4xx 直接失败
QA_AI_MAX_RETRIES=2
# 以下两项是溯源与缓存失效开关：写入每次分析记录（前端可见），并参与输入指纹，
# 改动即让历史分析结果失效、触发重新分析。
# 注意：提示词正文硬编码在 ai_analysis.py 的 _model_entities 中、不参与指纹计算，
# 改完提示词必须同步 bump 本项，否则旧结果会被直接复用而无人察觉。
QA_AI_PROMPT_VERSION=qa-entity-v1
QA_AI_SCHEMA_VERSION=qa-entity-schema-v1

# QA 正文提取后端：新上传与手动重提取统一使用 MinerU v4 异步解析。
# MinerU token 仅配置在部署环境，不要提交真实值。
# 注意：provider=mineru 时 token 必须填，否则应用启动即报错——
# 否则每次上传都会在后台解析失败，只在文档详情里留一条失败状态。
# 没有 token 的环境请显式改为 native。
QA_MD_EXTRACT_PROVIDER=mineru
QA_MD_EXTRACT_API_TOKEN=

# —— 质量模块 quality ——
# 独立飞书应用（消息推送 + WS 事件监听）：未配置则跳过推送与事件监听
QUALITY_FEISHU_APP_ID=***
QUALITY_FEISHU_APP_SECRET=***
# 推送目标群（逗号分隔）：任务提醒 / 不合格告警 / 每日早报 / 物料与盘点提醒
# 与上面两项任一为空时不推送
QUALITY_FEISHU_CHAT_IDS=
# 不合格提醒 @ 的负责人 open_id 列表（逗号分隔）；空 = 仅普通群消息，不 @ 人
QUALITY_FEISHU_ALERT_USER_IDS=
# 定时推送时间（HH:MM，Asia/Shanghai）
# 早报：今日出报任务 + 待复核 + 标准文件到期提醒
QUALITY_PUSH_MORNING=08:05
# 午后催办：当日未完成任务再提醒
QUALITY_PUSH_REMIND=15:00
# 物料/留样等提醒
QUALITY_PUSH_MATERIAL=08:15
# 盘点提醒固定在每月 25 日 09:00，无需配置
# 液相图谱解析复用 QA 模块的 MinerU 凭证（见上方 QA_MD_EXTRACT_API_TOKEN）
# 液相加密计算表服务端兜底密码：前端密码框留空且文件加密时自动使用；
# 密码只放部署环境，不出现在前端代码。留空 = 无兜底（用户需手填密码）
QUALITY_LC_EXCEL_PASSWORD=

# —— Energy 模块 ——
# 能耗自动采集
ENERGY_AUTO_COLLECT_ENABLED=false
# 车间能耗预警
ENERGY_WORKSHOP_ALERT_ENABLED=false
# 日耗推送 / 氮气月度推送
ENERGY_DAILY_PUSH_ENABLED=false
ENERGY_NITROGEN_PUSH_ENABLED=false

# ---- 仓储模块专属飞书应用（仓库管理机器人）与 Agent 模型 ----
# 提示：WAREHOUSE_AGENT_* 各键现为「DB 缺行时的字段级兜底层」——管理页
# （/warehouse/system）落库配置优先于本文件，改值无需重启。
WAREHOUSE_FEISHU_APP_ID=
WAREHOUSE_FEISHU_APP_SECRET=
# 仓储机器人专属飞书事件 WS 长连接开关（true 时 main.py 启动 warehouse WS 客户端）
WAREHOUSE_FEISHU_WS_ENABLED=false
# 冒烟测试用群 chat_id（配置后冒烟测试真发一张卡片到该群，未配置则跳过）
WAREHOUSE_TEST_CHAT_ID=
# 仓库机器人 open_id（部署身份：gateway 去重排除自身消息；未配置回退代码内默认值）
WAREHOUSE_FEISHU_BOT_OPEN_ID=
WAREHOUSE_FEISHU_BITABLE_MATERIAL_APP_TOKEN=
WAREHOUSE_FEISHU_BITABLE_GMP_APP_TOKEN=
WAREHOUSE_FEISHU_BITABLE_PROD_APP_TOKEN=
WAREHOUSE_FEISHU_BITABLE_SALES_APP_TOKEN=
# 遗留键（工作版预留）：连接坐标已由管理页 bitable_connections DB 行承接，此键不再读取
WAREHOUSE_FEISHU_BITABLE_MATERIAL_PROD_APP_TOKEN=
WAREHOUSE_AGENT_BASE_URL=
WAREHOUSE_AGENT_API_KEY=
WAREHOUSE_AGENT_MODEL=
WAREHOUSE_AGENT_TIMEOUT=120
# Agent 备用模型（主模型 401/429/5xx/超时自动降级；三项齐备才启用降级）
WAREHOUSE_AGENT_BACKUP_API_KEY=
WAREHOUSE_AGENT_BACKUP_BASE_URL=
WAREHOUSE_AGENT_BACKUP_MODEL=
# 系统提示词追加段（DB 配置 system_prompt_override 缺行时兜底）
WAREHOUSE_AGENT_SYSTEM_PROMPT=
# 系统告警目标群（AI 调用失败等告警；DB 配置 system_alert.target 缺行时兜底）
WAREHOUSE_ALERT_CHAT_ID=
# Runner tool-calling 循环上限 / 会话历史注入轮数（DB 配置缺行时兜底）
WAREHOUSE_AGENT_MAX_TURNS=10
WAREHOUSE_AGENT_SESSION_ROUNDS=12

# ---- 五金库审批（「福兴电子领/退料单审批」，申领/报废/退料共用一个定义）----
# 领料通道：feishu=前端申领提交即代发起审批实例；manual（默认）=系统内代录
HARDWARE_APPROVAL_CHANNEL=manual
# 审批定义 code（业务部门在飞书后台建好/改好后填）
HARDWARE_APPROVAL_CODE=
# 审批实例对账任务开关：本地联调置 false——防生产真实实例被摄取进本地库
# 污染测试数据（轮询/WS 事件不受影响）
HARDWARE_APPROVAL_RECONCILE_ENABLED=true
# 「主管及以上审批」节点 id（定义改版后节点 id 变化时覆盖；空=用代码默认值）
HARDWARE_APPROVAL_NODE_ID=
# 报废审批（2026-11-25）：复用同一审批定义的「五金库报废出库」分流分支——
# ① 飞书后台给分流键加「报废出库」选项，把生成的选项 value 填到下行
HARDWARE_SCRAP_KIND_VALUE=
# ② 加五个控件（显示条件=报废分支）：发起部门/发起人/报废条件及说明/
#    报废明细/报废单号，把控件 id 按 JSON 填到下行即启用飞书审批；
#    留空=审批人在平台「申请单据 → 待审批」点通过
HARDWARE_SCRAP_FORM_WIDGETS=
# 退料审批（2026-11-26）：复用同一审批定义的「五金库退料-平台」分流分支——
# ① 分流键加「退料-平台」选项，value 填到下行
HARDWARE_RETURN_KIND_VALUE=
# ② 六控件（显示条件=退料-平台分支）：退料部门/退料人/原领料单号/退料明细/
#    退库单号/退料说明，控件 id 按 JSON 填到下行（键：dept/starter/
#    source_req_no/items/return_no/reason）即启用；留空=审批人在平台点通过
HARDWARE_RETURN_FORM_WIDGETS=

# ---- 五金库其余配置（镜像/自动入账；已迁系统配置的运行参数页，env 仅兜底）----
# 物资目录镜像表坐标（系统配置运行参数页可改；生产部署翻新前本地置空防双写）
HARDWARE_MIRROR_BASE_TOKEN=
HARDWARE_MIRROR_TABLE_ID=
# direct 类高置信自动入账开关与阈值（系统配置运行参数页优先）
HARDWARE_OCR_AUTO_DIRECT_ENABLED=false
HARDWARE_OCR_AUTO_DIRECT_MIN_CONFIDENCE=0.9
# 月度用量管控表 table id（空=任务自空转）
HARDWARE_USAGE_TABLE_ID=
# 紧急领料仓管加急卡通知目标（逗号分隔 open_id/chat_id）
HARDWARE_URGENT_NOTIFY_TARGETS=

# ---- 安全模块：AI 检索增强（向量/备用模型） ----
SAFETY_AI_TEXT_BACKUP_API_KEY=
SAFETY_AI_TEXT_BACKUP_BASE_URL=
SAFETY_AI_TEXT_BACKUP_MODEL=
SAFETY_EMBEDDING_API_KEY=
SAFETY_EMBEDDING_BASE_URL=
SAFETY_EMBEDDING_MODEL=
